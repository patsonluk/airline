# Copy to .env and adjust
DB_NAME=airline_v2_1
DB_USER=sa
DB_PASSWORD=admin
MYSQL_ROOT_PASSWORD=rootpw

# Play needs a secret of 32+ chars in production mode. Generate: openssl rand -hex 32
APPLICATION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional: Google Maps key (see README step 8)
GOOGLE_MAP_KEY=
GOOGLE_API_KEY=

# JVM heap for init/simulation
JAVA_MEM=-Xms512m -Xmx2g

# Uncomment to include Elasticsearch/flight search in plain `docker compose up -d`
#COMPOSE_PROFILES=search
